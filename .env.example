# .env.example
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real API key:
#   cp .env.example .env
#
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────

# Required — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Models (defaults shown — gpt-4o-mini is cheap and good for learning)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant — where your vector database is running
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=aras_documents

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
